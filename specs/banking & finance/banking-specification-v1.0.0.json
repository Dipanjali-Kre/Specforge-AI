{
  "openapi": "3.1.0",
  "info": {
    "title": "Banking API",
    "version": "1.0.0",
    "description": "The Banking API provides secure access to customer accounts, transactions, and financial data, enabling seamless integration for banking applications and services.\n\n**Compliance Requirements:**\n- **PCI-DSS:** Never exposes full card numbers (PAN) in responses. Uses masking (last 4 digits).\n- **PSD2/Open Banking:** Includes consent management endpoints.\n- **KYC/AML:** Customer onboarding includes identity verification steps.\n- **Monetary Amounts:** All monetary amounts use explicit decimal with `currencyCode` (ISO 4217).\n\n**Security:**\n- **OAuth 2.0:** With scope-based access (`accounts:read`, `transactions:write`, etc.).\n- **Strong Customer Authentication (SCA):** For payment initiation.\n- **Rate Limiting:** On sensitive endpoints (e.g., transactions).\n- **Idempotency Keys:** For POST operations (`Idempotency-Key` header).",
    "contact": {
      "name": "API Support",
      "url": "https://www.example.com/support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "https://api.example.com/api/v1",
      "description": "Production server"
    },
    {
      "url": "https://sandbox.example.com/api/v1",
      "description": "Sandbox server for testing"
    }
  ],
  "security": [
    {
      "OAuth2Auth": [
        "accounts:read",
        "accounts:write",
        "transactions:read",
        "transactions:write",
        "payments:initiate",
        "cards:read",
        "cards:block",
        "customers:read",
        "customers:manage",
        "consents:read",
        "consents:manage"
      ]
    }
  ],
  "tags": [
    {
      "name": "Accounts",
      "description": "Operations related to customer bank accounts."
    },
    {
      "name": "Transactions",
      "description": "Operations related to financial transactions."
    },
    {
      "name": "Payments",
      "description": "Operations for initiating and managing payments."
    },
    {
      "name": "Cards",
      "description": "Operations related to customer debit/credit cards."
    },
    {
      "name": "Customers",
      "description": "Operations related to customer profiles and KYC."
    },
    {
      "name": "Consent Management",
      "description": "Operations for managing customer data consents (PSD2/Open Banking)."
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "tags": ["Accounts"],
        "summary": "List customer accounts",
        "description": "Retrieves a paginated list of all bank accounts associated with the authenticated customer. Requires `accounts:read` scope.",
        "operationId": "listCustomerAccounts",
        "security": [
          {
            "OAuth2Auth": ["accounts:read"]
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip before starting to collect the result set.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of customer accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAccountsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful response for listing accounts",
                    "value": {
                      "timestamp": "2023-10-27T10:00:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Accounts retrieved successfully.",
                      "data": {
                        "items": [
                          {
                            "accountRef": "acc_12345",
                            "accountNumber": "1234567890",
                            "accountType": "SAVINGS",
                            "balanceAmount": 1500.75,
                            "currencyCode": "USD",
                            "statusCode": "ACTIVE",
                            "accountHolder": "John Doe",
                            "openedDate": "2020-01-15"
                          },
                          {
                            "accountRef": "acc_67890",
                            "accountNumber": "0987654321",
                            "accountType": "CHECKING",
                            "balanceAmount": 3200.50,
                            "currencyCode": "USD",
                            "statusCode": "ACTIVE",
                            "accountHolder": "John Doe",
                            "openedDate": "2018-03-20"
                          }
                        ],
                        "pagination": {
                          "limit": 20,
                          "offset": 0,
                          "totalCount": 2,
                          "totalPages": 1,
                          "hasNextPage": false,
                          "hasPreviousPage": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/accounts/{accountRef}": {
      "get": {
        "tags": ["Accounts"],
        "summary": "Get account details",
        "description": "Retrieves detailed information for a specific bank account identified by `accountRef`. Requires `accounts:read` scope.",
        "operationId": "getAccountDetails",
        "security": [
          {
            "OAuth2Auth": ["accounts:read"]
          }
        ],
        "parameters": [
          {
            "name": "accountRef",
            "in": "path",
            "description": "Unique identifier for the account.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^acc_[a-zA-Z0-9]{5,30}$"
            },
            "example": "acc_12345"
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the specified account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetailsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful response for account details",
                    "value": {
                      "timestamp": "2023-10-27T10:05:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Account details retrieved successfully.",
                      "data": {
                        "accountRef": "acc_12345",
                        "accountNumber": "1234567890",
                        "accountType": "SAVINGS",
                        "balanceAmount": 1500.75,
                        "currencyCode": "USD",
                        "statusCode": "ACTIVE",
                        "accountHolder": "John Doe",
                        "openedDate": "2020-01-15"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/accounts/{accountRef}/transactions": {
      "get": {
        "tags": ["Transactions", "Accounts"],
        "summary": "List transactions for an account",
        "description": "Retrieves a paginated list of transactions for a specific bank account. Requires `transactions:read` scope.",
        "operationId": "listAccountTransactions",
        "security": [
          {
            "OAuth2Auth": ["transactions:read"]
          }
        ],
        "parameters": [
          {
            "name": "accountRef",
            "in": "path",
            "description": "Unique identifier for the account.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^acc_[a-zA-Z0-9]{5,30}$"
            },
            "example": "acc_12345"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip before starting to collect the result set.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Filter transactions from this date (inclusive). Format: YYYY-MM-DD.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2023-01-01"
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Filter transactions up to this date (inclusive). Format: YYYY-MM-DD.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2023-10-27"
          },
          {
            "name": "transactionType",
            "in": "query",
            "description": "Filter transactions by type.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["DEBIT", "CREDIT", "TRANSFER", "PAYMENT"]
            },
            "example": "DEBIT"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of transactions for the specified account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTransactionsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful response for listing account transactions",
                    "value": {
                      "timestamp": "2023-10-27T10:10:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Transactions retrieved successfully.",
                      "data": {
                        "items": [
                          {
                            "transactionId": "txn_abc123",
                            "accountRef": "acc_12345",
                            "totalAmount": -50.00,
                            "currencyCode": "USD",
                            "transactionType": "DEBIT",
                            "eventTimestamp": "2023-10-26T14:30:00Z",
                            "description": "Coffee Shop Purchase",
                            "merchantName": "Starbucks",
                            "statusCode": "COMPLETED"
                          },
                          {
                            "transactionId": "txn_def456",
                            "accountRef": "acc_12345",
                            "totalAmount": 200.00,
                            "currencyCode": "USD",
                            "transactionType": "CREDIT",
                            "eventTimestamp": "2023-10-25T09:00:00Z",
                            "description": "Salary Deposit",
                            "merchantName": "Employer Inc.",
                            "statusCode": "COMPLETED"
                          }
                        ],
                        "pagination": {
                          "limit": 20,
                          "offset": 0,
                          "totalCount": 2,
                          "totalPages": 1,
                          "hasNextPage": false,
                          "hasPreviousPage": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Initiate a new transaction",
        "description": "Initiates a new financial transaction, such as a transfer between accounts. Requires `transactions:write` scope. This endpoint supports idempotency via the `Idempotency-Key` header.",
        "operationId": "initiateTransaction",
        "security": [
          {
            "OAuth2Auth": ["transactions:write"]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique key to ensure that the request is processed only once. This helps prevent duplicate transactions if a request is retried.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          }
        ],
        "requestBody": {
          "description": "Details for the new transaction.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              },
              "examples": {
                "transferExample": {
                  "summary": "Example of an account transfer",
                  "value": {
                    "sourceAccountRef": "acc_12345",
                    "destinationAccountRef": "acc_67890",
                    "totalAmount": 100.00,
                    "currencyCode": "USD",
                    "transactionType": "TRANSFER",
                    "description": "Monthly rent payment"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction initiated successfully. Returns the new transaction details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful transaction initiation",
                    "value": {
                      "timestamp": "2023-10-27T10:15:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Transaction initiated successfully.",
                      "data": {
                        "transactionId": "txn_ghi789",
                        "sourceAccountRef": "acc_12345",
                        "destinationAccountRef": "acc_67890",
                        "totalAmount": 100.00,
                        "currencyCode": "USD",
                        "transactionType": "TRANSFER",
                        "eventTimestamp": "2023-10-27T10:15:00Z",
                        "description": "Monthly rent payment",
                        "statusCode": "PENDING"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/transactions/{transactionId}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Get transaction status and details",
        "description": "Retrieves the current status and full details of a specific transaction. Requires `transactions:read` scope.",
        "operationId": "getTransactionDetails",
        "security": [
          {
            "OAuth2Auth": ["transactions:read"]
          }
        ],
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "description": "Unique identifier for the transaction.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^txn_[a-zA-Z0-9]{5,30}$"
            },
            "example": "txn_ghi789"
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the specified transaction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful response for transaction details",
                    "value": {
                      "timestamp": "2023-10-27T10:20:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Transaction details retrieved successfully.",
                      "data": {
                        "transactionId": "txn_ghi789",
                        "sourceAccountRef": "acc_12345",
                        "destinationAccountRef": "acc_67890",
                        "totalAmount": 100.00,
                        "currencyCode": "USD",
                        "transactionType": "TRANSFER",
                        "eventTimestamp": "2023-10-27T10:15:00Z",
                        "description": "Monthly rent payment",
                        "statusCode": "COMPLETED"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": ["Payments"],
        "summary": "Initiate a new payment",
        "description": "Initiates a new payment from a customer's account to a beneficiary. This endpoint requires Strong Customer Authentication (SCA) and supports idempotency via the `Idempotency-Key` header.",
        "operationId": "initiatePayment",
        "security": [
          {
            "OAuth2Auth": ["payments:initiate"]
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "A unique key to ensure that the request is processed only once. This helps prevent duplicate payments if a request is retried.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "f1e2d3c4-b5a6-9876-5432-10fedcba9876"
          }
        ],
        "requestBody": {
          "description": "Details for the new payment, including SCA challenge data if applicable.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiatePaymentRequest"
              },
              "examples": {
                "paymentExample": {
                  "summary": "Example of a payment initiation",
                  "value": {
                    "sourceAccountRef": "acc_12345",
                    "beneficiaryName": "Utility Company",
                    "beneficiaryAccount": "9876543210",
                    "beneficiaryBankCode": "BANKUS33",
                    "totalAmount": 75.50,
                    "currencyCode": "USD",
                    "description": "Monthly utility bill",
                    "scaChallengeData": {
                      "challengeType": "OTP",
                      "challengeValue": "123456"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment initiated successfully. May require further SCA confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentInitiationResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful payment initiation",
                    "value": {
                      "timestamp": "2023-10-27T10:25:00Z",
                      "statusCode": "SUCCESS",
                      "message": "Payment initiated successfully. Awaiting SCA confirmation.",
                      "data": {
                        "paymentId": "pay_jkl012",
                        "sourceAccountRef": "acc_12345",
                        "totalAmount": 75.50,
                        "currencyCode": "USD",
                        "statusCode": "PENDING_SCA",
                        "scaRequired": true,
                        "scaMethod": "OTP_SMS",
                        "scaReference": "sca_ref_xyz"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "description": "Unprocessable Entity - SCA challenge required or failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "scaRequired": {
                    "summary": "SCA Challenge Required",
                    "value": {
                      "error": {
                        "code": "SCA_REQUIRED",
                        "message": "Strong Customer Authentication is required to complete this payment.",
                        "details": [
                          {
                            "field": "scaChallengeData",
                            "message": "Missing or invalid SCA challenge data."
                          }
                        ],
                        "traceId": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/cards": {
      "get": {
        "tags": ["Cards"],
        "summary": "List customer cards",
        "description": "Retrieves a paginated list of all debit and credit cards associated with the authenticated customer. Card numbers are masked for PCI-DSS compliance. Requires `cards:read` scope.",
        "operationId": "listCustomerCards",
        "security": [
          {
            "OAuth2Auth": ["cards:read"]
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return per page.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of items to skip before starting to collect the result set.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of customer cards.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedCardsResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful response for listing cards",
                    "value": {
                      "timestamp": "2023-10-27T10:30:00Z",
                      "statusCode": "SUCCESS",
