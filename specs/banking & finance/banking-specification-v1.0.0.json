                            "statusCode": "ACTIVE",
                            "cardholderName": "John Doe"
                          },
                          {
                            "cardId": "card_2222",
                            "maskedCardNumber": "************5678",
                            "cardType": "CREDIT",
                            "expiryDate": "06/27",
                            "statusCode": "ACTIVE",
                            "cardholderName": "John Doe"
                          }
                        ],
                        "pagination": {
                          "limit": 20,
                          "offset": 0,
                          "totalCount": 2,
                          "totalPages": 1,
                          "hasNextPage": false,
                          "hasPreviousPage": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/cards/{cardId}/block": {
      "post": {
        "tags": ["Cards"],
        "summary": "Block a card",
        "description": "Blocks a specific card due to loss, theft, or other reasons. This action is irreversible. Requires `cards:block` scope.",
        "operationId": "blockCard",
        "security": [
          {
            "OAuth2Auth": ["cards:block"]
          }
        ],
        "parameters": [
          {
            "name": "cardId",
            "in": "path",
            "description": "Unique identifier for the card to be blocked.",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^card_[a-zA-Z0-9]{5,30}$"
            },
            "example": "card_1111"
          }
        ],
        "requestBody": {
          "description": "Reason for blocking the card.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlockCardRequest"
              },
              "examples": {
                "blockReason": {
                  "summary": "Example block card request",
                  "value": {
                    "reason": "LOST",
                    "description": "Card lost during travel."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
