                "examples": {
                  "patientList": {
                    "value": {
                      "items": [
                        {
                          "id": "d290f1ee-6c54-4b01-90e6-d701748f0851",
                          "firstName": "John",
                          "lastName": "Doe",
                          "dob": "1980-01-15",
                          "phone": "+15551234567"
                        },
                        {
                          "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
                          "firstName": "Jane",
                          "lastName": "Smith",
                          "dob": "1992-03-22",
