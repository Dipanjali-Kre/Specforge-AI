{
  "openapi": "3.0.3",
  "info": {
    "title": "Healthcare API",
    "description": "Sample API spec for healthcare proxy generation.\n\nThis API adheres to strict security and operational standards, including comprehensive logging and audit trails facilitated by the `X-Request-ID` header. All operations are subject to service level agreements (SLAs) with defined timeouts, typically 30 seconds for synchronous operations, to ensure responsiveness and reliability.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/healthcare",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Appointments",
      "description": "Operations related to patient appointments."
    ,
      "externalDocs": {
        "description": "Find out more about appointments",
        "url": "http://example.com/docs/appointments"
      }
    },
    {
      "name": "Patients",
      "description": "Operations related to patient records."
    ,
      "externalDocs": {
        "description": "Find out more about patients",
        "url": "http://example.com/docs/patients"
      }
    },
    {
      "name": "Prescriptions",
      "description": "Operations related to medical prescriptions."
    ,
      "externalDocs": {
        "description": "Find out more about prescriptions",
        "url": "http://example.com/docs/prescriptions"
      }
    },
    {
      "name": "Health",
      "description": "API health check endpoint."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API health status",
        "description": "Returns the current health status of the API. A successful response indicates the API is operational.",
        "operationId": "getHealthStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Request-ID"
          }
        ],
        "responses": {
          "200": {
            "description": "API is healthy and operational.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "UP",
                      "description": "Current status of the API."
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2023-10-27T10:30:00Z",
                      "description": "Timestamp of the health check."
                    }
                  }
                },
                "examples": {
                  "healthy": {
                    "value": {
                      "status": "UP",
                      "timestamp": "2023-10-27T10:30:00Z"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "internalError": {
                    "value": {
                      "code": "SERVER_ERROR",
                      "message": "An unexpected error occurred on the server."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/patients": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "List patients",
        "description": "Retrieves a paginated list of all patient records.",
        "operationId": "listPatients",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
