    "schemas": {
      "Patient": {
        "type": "object",
        "description": "Represents a patient record.",
        "required": [
          "id",
          "firstName",
          "lastName",
          "dob"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the patient.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the patient.",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the patient.",
            "example": "Doe"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "description": "Date of birth of the patient (YYYY-MM-DD).",
            "example": "1980-01-15"
          },
          "phone": {
            "type": "string",
            "description": "Phone number of the patient in E.164 format.",
            "pattern": "^\\+?[1-9]\\d{1,14}$",
            "example": "+15551234567"
          }
        }
      },
      "PatientInput": {
        "type": "object",
        "description": "Input schema for creating a new patient. 'id' is generated by the system.",
        "required": [
          "firstName",
          "lastName",
          "dob"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name of the patient.",
            "example": "Alice"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the patient.",
            "example": "Johnson"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "description": "Date of birth of the patient (YYYY-MM-DD).",
            "example": "1995-07-01"
          },
          "phone": {
            "type": "string",
            "description": "Phone number of the patient in E.164 format.",
            "pattern": "^\\+?[1-9]\\d{1,14}$",
            "example": "+15551112222"
          }
        }
      },
      "PaginatedPatients": {
        "type": "object",
        "description": "A paginated list of patients.",
        "properties": {
          "items": {
            "type": "array",
            "description": "List of patient records.",
            "items": {
              "$ref": "#/components/schemas/Patient"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of patient records available.",
            "example": 100
          },
          "limit": {
            "type": "integer",
            "description": "The maximum number of items returned in the response.",
            "example": 10
          },
          "offset": {
            "type": "integer",
            "description": "The number of items skipped before starting to collect the result set.",
            "example": 0
          }
        }
      },
      "Appointment": {
        "type": "object",
        "description": "Represents a scheduled appointment.",
        "required": [
          "id",
          "patientId",
          "doctorId",
          "dateTime",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the appointment.",
            "example": "a1b2c3d4-e5f6-7890-1234-567890abcdef"
          },
          "patientId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the patient attending the appointment.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "doctorId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the doctor conducting the appointment.",
            "example": "f1e2d3c4-b5a6-0987-6543-210fedcba987"
          },
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the appointment in ISO 8601 format (UTC).",
            "example": "2023-10-27T10:00:00Z"
          },
          "status": {
            "type": "string",
            "description": "Current status of the appointment.",
            "enum": [
              "scheduled",
              "completed",
              "cancelled",
              "no-show"
            ],
            "example": "scheduled"
          }
        }
      },
      "AppointmentInput": {
        "type": "object",
        "description": "Input schema for booking a new appointment. 'id' is generated by the system.",
        "required": [
          "patientId",
          "doctorId",
          "dateTime",
          "status"
        ],
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the patient attending the appointment.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "doctorId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the doctor conducting the appointment.",
            "example": "f1e2d3c4-b5a6-0987-6543-210fedcba987"
          },
          "dateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the appointment in ISO 8601 format (UTC).",
            "example": "2023-11-01T11:00:00Z"
          },
          "status": {
            "type": "string",
            "description": "Initial status of the appointment.",
            "enum": [
              "scheduled"
            ],
            "default": "scheduled",
            "example": "scheduled"
          }
        }
