            "example": 10
          },
          "offset": {
            "type": "integer",
            "description": "The number of items skipped before starting to collect the result set.",
            "example": 0
          }
        }
      },
      "Prescription": {
        "type": "object",
        "description": "Represents a medical prescription.",
        "required": [
          "id",
          "patientId",
          "medicine",
          "dosage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the prescription.",
            "example": "p1r2e3s4-c5r6-i7p8-t9i0o-n1234567890"
          },
          "patientId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the patient for whom the prescription is issued.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "medicine": {
            "type": "string",
            "description": "Name of the prescribed medicine.",
            "example": "Amoxicillin"
          },
          "dosage": {
            "type": "string",
            "description": "Dosage instructions for the medicine.",
            "example": "500mg, twice daily for 7 days"
          }
        }
      },
      "PrescriptionInput": {
        "type": "object",
        "description": "Input schema for creating a new prescription. 'id' is generated by the system.",
        "required": [
          "patientId",
          "medicine",
          "dosage"
        ],
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the patient for whom the prescription is issued.",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "medicine": {
            "type": "string",
            "description": "Name of the prescribed medicine.",
            "example": "Ibuprofen"
          },
          "dosage": {
            "type": "string",
            "description": "Dosage instructions for the medicine.",
            "example": "200mg, every 4-6 hours as needed"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Standard error response format.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A unique error code identifying the type of error.",
            "example": "INVALID_INPUT"
          },
          "message": {
            "type": "string",
            "description": "A human-readable explanation of the error.",
            "example": "The provided patient ID is not a valid UUID."
          },
          "details": {
            "type": "array",
            "description": "Optional array of detailed error messages, e.g., for validation errors on specific fields.",
            "items": {
              "type": "string"
            },
            "example": [
              "Field 'dob' must be in YYYY-MM-DD format."
            ]
          }
        }
      }
    }
